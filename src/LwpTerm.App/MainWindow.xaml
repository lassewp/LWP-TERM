<Window x:Class="LwpTerm.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonDock="https://github.com/Dirkster99/AvalonDock"
        xmlns:vm="clr-namespace:LwpTerm.App.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainWindowViewModel}"
        Title="{Binding Title}"
        Icon="pack://application:,,,/app.ico"
        Height="820" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Bg}"
        TextElement.Foreground="{StaticResource Brush.Text}"
        FontSize="13">

    <Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Control" Command="{Binding CloseTabCommand}" />
        <KeyBinding Key="T" Modifiers="Control" Command="{Binding NewLocalShellCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>
            <!-- Toolbar -->
            <Border x:Name="ToolbarBar" DockPanel.Dock="Top" Background="{StaticResource Brush.Panel}"
                    BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                <DockPanel Margin="4">
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}" Command="{Binding NewLocalShellCommand}"
                            ToolTip="New local shell (Ctrl+T)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE756;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                            <TextBlock Text="New shell" />
                        </StackPanel>
                    </Button>
                    <Separator DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                            Command="{Binding Sessions.ConnectCommand}" ToolTip="Connect selected session">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE71B;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                            <TextBlock Text="Connect" />
                        </StackPanel>
                    </Button>

                    <Separator DockPanel.Dock="Left" />
                    <Button DockPanel.Dock="Left" Style="{StaticResource ToolbarButton}"
                            Click="OnMenuFullScreen"
                            ToolTip="Full screen (F11) — hold Shift for borderless">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE1D9;" Style="{StaticResource IconText}" Margin="0,0,6,0" />
                            <TextBlock Text="Full screen" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="ViewMenuButton" DockPanel.Dock="Right" Style="{StaticResource ToolbarButton}"
                            Click="OnViewMenu" ToolTip="Settings &amp; layout">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE713;" Style="{StaticResource IconText}" />
                            <TextBlock Text="&#xE70D;" Style="{StaticResource IconText}" FontSize="9" Margin="4,1,0,0" />
                        </StackPanel>
                        <Button.ContextMenu>
                            <ContextMenu x:Name="ViewMenu">
                                <MenuItem x:Name="MenuVersion" Header="LWP-TERM" IsEnabled="False" />
                                <MenuItem Header="Check for updates…" Click="OnCheckUpdates" />
                                <Separator />
                                <MenuItem Header="Settings…" Click="OnMenuSettings" />
                                <MenuItem Header="Import PuTTY sessions…" Click="OnImportPutty" />
                                <Separator />
                                <MenuItem x:Name="MenuFullScreen" Header="Full screen" IsCheckable="True"
                                          InputGestureText="F11" Click="OnMenuFullScreen" />
                                <MenuItem x:Name="MenuBorderless" Header="Borderless full screen" IsCheckable="True"
                                          InputGestureText="Shift+F11" Click="OnMenuBorderless" />
                                <Separator />
                                <MenuItem x:Name="MenuPaneSessions" Header="Sessions panel" IsCheckable="True"
                                          Click="OnTogglePane" Tag="Sessions" />
                                <MenuItem x:Name="MenuPaneTransfers" Header="Transfers panel" IsCheckable="True"
                                          Click="OnTogglePane" Tag="Transfers" />
                                <MenuItem x:Name="MenuPaneLog" Header="Log panel" IsCheckable="True"
                                          Click="OnTogglePane" Tag="Log" />
                                <Separator />
                                <MenuItem Header="Reset layout" Click="OnResetLayout" />
                                <MenuItem Header="Save layout as…" Click="OnSaveLayoutAs" />
                                <MenuItem x:Name="MenuLayouts" Header="Saved layouts" />
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Grid Margin="16,0,8,0">
                        <TextBox Text="{Binding QuickConnectText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.Text}"
                                 BorderBrush="{StaticResource Brush.Border}" Padding="4,3"
                                 ToolTip="Quick connect: ssh://user@host:port, telnet://host, rdp://host, …">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding QuickConnectCommand}" />
                            </TextBox.InputBindings>
                        </TextBox>
                        <TextBlock Text="Quick connect (Enter)…  e.g. user@host  or  rdp://10.0.0.5"
                                   Margin="6,0,0,0" Foreground="{StaticResource Brush.TextDim}"
                                   IsHitTestVisible="False" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding QuickConnectText}" Value="">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border x:Name="StatusBar" DockPanel.Dock="Bottom" Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid Margin="8,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Foreground="{StaticResource Brush.TextDim}"
                           Text="{Binding ActiveDocument.StatusText, TargetNullValue='Ready', FallbackValue='Ready'}" />
                <TextBlock Grid.Column="1" Foreground="{StaticResource Brush.TextDim}"
                           Text="{Binding ActiveDocument.State, TargetNullValue='', FallbackValue=''}" />
            </Grid>
        </Border>

        <!-- Docking area -->
        <avalonDock:DockingManager x:Name="Dock"
                                   DocumentsSource="{Binding Documents}"
                                   ActiveContent="{Binding ActiveDocument, Mode=TwoWay}"
                                   AllowMixedOrientation="True"
                                   Background="{StaticResource Brush.Bg}">
            <avalonDock:DockingManager.DocumentHeaderTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Background="Transparent"
                                MouseDown="OnDocumentHeaderMouseDown">
                        <TextBlock Text="{Binding Content.Title}" VerticalAlignment="Center" />
                        <!-- Handled on MouseDown: AvalonDock captures the mouse for
                             tab drag and never delivers the matching MouseUp. -->
                        <Border Background="Transparent" Cursor="Hand" Margin="6,0,0,0" Padding="7,2,3,2"
                                MouseDown="OnHeaderFullScreen"
                                ToolTip="Full screen (F11) — hold Shift for borderless; double-clicking the tab works too">
                            <TextBlock Text="&#xE1D9;" FontSize="12">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource IconText}">
                                        <Setter Property="Opacity" Value="0.55" />
                                        <Style.Triggers>
                                            <DataTrigger Value="True"
                                                Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Border}}">
                                                <Setter Property="Opacity" Value="1" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </StackPanel>
                </DataTemplate>
            </avalonDock:DockingManager.DocumentHeaderTemplate>

            <avalonDock:LayoutRoot>
                <avalonDock:LayoutPanel Orientation="Horizontal">

                    <avalonDock:LayoutAnchorablePane DockWidth="290">
                        <avalonDock:LayoutAnchorable x:Name="SessionsPane"
                                                     Title="Sessions" ContentId="sessions"
                                                     CanClose="False" CanHide="True">
                            <ContentControl Content="{Binding Sessions}" />
                        </avalonDock:LayoutAnchorable>
                    </avalonDock:LayoutAnchorablePane>

                    <avalonDock:LayoutPanel Orientation="Vertical">
                        <avalonDock:LayoutDocumentPane x:Name="DocPane" />

                        <avalonDock:LayoutAnchorablePane DockHeight="190">
                            <avalonDock:LayoutAnchorable x:Name="TransfersPane"
                                                         Title="Transfers" ContentId="transfers"
                                                         CanClose="False">
                                <ContentControl Content="{Binding Transfers}" />
                            </avalonDock:LayoutAnchorable>
                            <avalonDock:LayoutAnchorable x:Name="LogPane"
                                                         Title="Log" ContentId="log"
                                                         CanClose="False">
                                <ContentControl Content="{Binding Log}" />
                            </avalonDock:LayoutAnchorable>
                        </avalonDock:LayoutAnchorablePane>
                    </avalonDock:LayoutPanel>

                </avalonDock:LayoutPanel>
            </avalonDock:LayoutRoot>
        </avalonDock:DockingManager>
        </DockPanel>
    </Grid>
</Window>
