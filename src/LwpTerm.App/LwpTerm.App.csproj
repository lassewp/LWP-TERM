<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>LwpTerm.App</RootNamespace>
    <AssemblyName>LwpTerm</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Version>0.1.5</Version>
    <!-- Custom entry point (Program.Main) so Velopack hooks run before WPF. -->
    <StartupObject>LwpTerm.App.Program</StartupObject>
    <!-- This is a WPF app; per-monitor DPI v2 is declared in app.manifest (which WPF honours).
         WFAC010 is the WinForms-only guidance to move it to a project property. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
  </PropertyGroup>

  <!-- WinForms is enabled for hosting the RDP ActiveX control (M5). Drop its
       implicit global usings so System.Windows.* stays unambiguous in WPF code. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LwpTerm.Core\LwpTerm.Core.csproj" />
    <ProjectReference Include="..\LwpTerm.Connections\LwpTerm.Connections.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\webterm\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="app.ico" />
  </ItemGroup>

  <!-- App.xaml compiled as a Page (not ApplicationDefinition) so MSBuild does not
       generate a Main; Program.Main is the entry point instead. -->
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
    <PackageReference Include="Dirkster.AvalonDock" Version="4.72.0" />
    <PackageReference Include="Dirkster.AvalonDock.Themes.VS2013" Version="4.72.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.2.0" />
    <!-- VncSharp ships as a .NET Framework library; it runs on the Windows Desktop
         runtime (WinForms + System.Drawing). NU1701 is the cross-TFM advisory. -->
    <PackageReference Include="VncSharp" Version="1.0.7" NoWarn="NU1701" />
  </ItemGroup>

  <!-- RDP: interop for the MSTSC ActiveX control (AxMsRdpClient9NotSafeForScripting),
       generated with AxImp from %WINDIR%\System32\mstscax.dll and committed here. -->
  <ItemGroup>
    <Reference Include="MSTSCLib">
      <HintPath>Interop\MSTSCLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
    <Reference Include="AxMSTSCLib">
      <HintPath>Interop\AxMSTSCLib.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

</Project>
