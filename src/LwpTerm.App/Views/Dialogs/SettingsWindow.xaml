<Window x:Class="LwpTerm.App.Views.Dialogs.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LwpTerm.App.ViewModels"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
        Title="Settings" Height="560" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Brush.Bg}"
        TextElement.Foreground="{StaticResource Brush.Text}" FontSize="13">
    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="L">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style TargetType="TextBlock" x:Key="Hint">
            <Setter Property="Foreground" Value="{StaticResource Brush.TextDim}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource Brush.Panel}" />
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
            <Setter Property="Padding" Value="4,3" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Padding" Value="14,7" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top" Text="Settings" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Save" Width="90" Height="28" IsDefault="True" Click="OnSave" />
            <Button Content="Cancel" Width="90" Height="28" Margin="8,0,0,0" IsCancel="True" />
        </StackPanel>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding StatusText}" Style="{StaticResource Hint}" />

        <TabControl Background="Transparent" BorderBrush="{StaticResource Brush.Border}">

            <TabItem Header="Appearance">
                <StackPanel Margin="2,14,2,4">
                    <TextBlock Text="Theme (applies after restart)" Style="{StaticResource L}" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" />

                    <TextBlock Text="Terminal font family" Style="{StaticResource L}" />
                    <TextBox Text="{Binding TerminalFontFamily, UpdateSourceTrigger=PropertyChanged}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Font size" Style="{StaticResource L}" />
                            <TextBox Text="{Binding TerminalFontSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Scrollback lines" Style="{StaticResource L}" />
                            <TextBox Text="{Binding TerminalScrollback, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </TabItem>

            <TabItem Header="Terminal &amp; Shell">
                <StackPanel Margin="2,14,2,4">
                    <TextBlock Text="Default shell (Ctrl+T / toolbar)" Style="{StaticResource L}" Margin="0,0,0,2" />
                    <ComboBox ItemsSource="{Binding Shells}" SelectedItem="{Binding DefaultShell}" />

                    <CheckBox Content="Colourise terminal output (highlight IPs, up/down, yes/no, …)"
                              IsChecked="{Binding ColorizeOutput}" />

                    <CheckBox Content="Restore open tabs on startup" IsChecked="{Binding RestoreTabs}" />
                </StackPanel>
            </TabItem>

            <TabItem Header="Security">
                <StackPanel Margin="2,14,2,4">
                    <TextBlock Text="Master password" Style="{StaticResource L}" Margin="0,0,0,2" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,0,0,10"
                               Text="Encrypts saved passwords and private keys with a password only you know, instead of relying solely on your Windows account (DPAPI)." />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource L}" Margin="0"
                                   Text="{Binding MasterPasswordEnabled, StringFormat='Currently: {0}'}" />
                        <Button Content="Enable / Disable" Margin="12,0,0,0" Padding="8,2"
                                Command="{Binding ToggleMasterPasswordCommand}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>

        </TabControl>
    </DockPanel>
</Window>
