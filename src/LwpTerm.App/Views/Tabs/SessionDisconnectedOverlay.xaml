<UserControl x:Class="LwpTerm.App.Views.Tabs.SessionDisconnectedOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LwpTerm.App.ViewModels"
             xmlns:tabsvm="clr-namespace:LwpTerm.App.ViewModels.Tabs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             x:Name="Root"
             d:DataContext="{d:DesignInstance tabsvm:SessionTabViewModel}"
             Visibility="{Binding IsDisconnected, Converter={x:Static vm:BoolToVisibilityConverter.Instance}}">

    <!-- Scrim over the dead session surface -->
    <Grid Background="#B0000000">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{StaticResource Brush.Panel}"
                BorderBrush="{StaticResource Brush.Border}" BorderThickness="1"
                CornerRadius="6" Padding="28,22" MinWidth="360" MaxWidth="560">
            <StackPanel>
                <TextBlock Text="{Binding StatusText, TargetNullValue='The session has been disconnected.', FallbackValue='The session has been disconnected.'}"
                           Foreground="{StaticResource Brush.Text}" FontSize="14"
                           TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                    <Button Command="{Binding ReconnectCommand}"
                            IsEnabled="{Binding CanReconnect}"
                            IsDefault="True"
                            Cursor="Hand" Padding="18,7" MinWidth="120"
                            Background="{StaticResource Brush.Accent}" Foreground="White"
                            BorderThickness="0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72C;" FontFamily="{StaticResource Font.Icon}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Reconnect" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding QuitSessionCommand}"
                            Cursor="Hand" Padding="18,7" MinWidth="120" Margin="12,0,0,0"
                            Background="Transparent" Foreground="{StaticResource Brush.Text}"
                            BorderBrush="{StaticResource Brush.Border}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE711;" FontFamily="{StaticResource Font.Icon}"
                                       Foreground="{StaticResource Brush.Error}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBlock Text="Quit" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <ContentControl x:Name="ExtraHost"
                                Content="{Binding ExtraContent, ElementName=Root}"
                                HorizontalAlignment="Center" Margin="0,14,0,0" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
