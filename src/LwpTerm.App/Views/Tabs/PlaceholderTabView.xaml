<UserControl x:Class="LwpTerm.App.Views.Tabs.PlaceholderTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabsvm="clr-namespace:LwpTerm.App.ViewModels.Tabs"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabsvm:PlaceholderTabViewModel}"
             Background="{StaticResource Brush.Bg}">

    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="&#xE7B8;" FontFamily="{StaticResource Font.Icon}" FontSize="48"
                   HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
        <TextBlock Text="{Binding Protocol}" FontSize="20" Margin="0,12,0,0"
                   HorizontalAlignment="Center" Foreground="{StaticResource Brush.Text}" />
        <TextBlock Text="{Binding Target}" Margin="0,4,0,0"
                   HorizontalAlignment="Center" Foreground="{StaticResource Brush.TextDim}" />
        <TextBlock Text="This protocol surface is implemented in a later milestone."
                   Margin="0,16,0,0" HorizontalAlignment="Center"
                   Foreground="{StaticResource Brush.TextDim}" FontStyle="Italic" />
    </StackPanel>
</UserControl>
