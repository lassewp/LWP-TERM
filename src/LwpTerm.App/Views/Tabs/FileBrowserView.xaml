<UserControl x:Class="LwpTerm.App.Views.Tabs.FileBrowserView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabsvm="clr-namespace:LwpTerm.App.ViewModels.Tabs"
             xmlns:fb="clr-namespace:LwpTerm.App.ViewModels.FileBrowser"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabsvm:FileBrowserTabViewModel}"
             Background="{StaticResource Brush.Bg}"
             TextElement.Foreground="{StaticResource Brush.Text}">

    <UserControl.Resources>
        <DataTemplate x:Key="NameCell" DataType="{x:Type fb:FileEntryViewModel}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icon}"
                           Margin="0,0,6,0" Foreground="{StaticResource Brush.TextDim}" />
                <TextBlock Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Local pane -->
        <DockPanel Grid.Column="0" Margin="4">
            <Grid DockPanel.Dock="Top">
                <TextBlock Text="Local" FontWeight="Bold" Margin="2,0,0,4" Foreground="{StaticResource Brush.TextDim}" />
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="&#xE72B; Up" Style="{StaticResource ToolbarButton}" Command="{Binding Local.UpCommand}" />
                <Button Content="&#xE72C; Refresh" Style="{StaticResource ToolbarButton}" Command="{Binding Local.RefreshCommand}" />
                <Button Content="&#xE8F4; New folder" Style="{StaticResource ToolbarButton}" Command="{Binding Local.NewFolderCommand}" />
            </StackPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding Local.CurrentPath, Mode=OneWay}" IsReadOnly="True"
                     Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.TextDim}"
                     BorderBrush="{StaticResource Brush.Border}" Padding="4,3" Margin="0,0,0,4" />
            <DataGrid x:Name="LocalGrid" ItemsSource="{Binding Local.Entries}" AutoGenerateColumns="False"
                      Background="Transparent" RowBackground="Transparent" BorderThickness="1"
                      BorderBrush="{StaticResource Brush.Border}" GridLinesVisibility="None"
                      HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Extended"
                      Foreground="{StaticResource Brush.Text}" AllowDrop="True"
                      MouseDoubleClick="OnLocalDoubleClick"
                      PreviewMouseLeftButtonDown="OnGridPreviewLeftDown"
                      PreviewMouseMove="OnGridPreviewMouseMove"
                      DragOver="OnGridDragOver" Drop="OnLocalDrop">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="130" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>

        <!-- Transfer buttons -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4">
            <Button Content="&#xE72A;" ToolTip="Upload selected (local → remote)" FontFamily="{StaticResource Font.Icon}"
                    Width="34" Height="34" Margin="0,4" Command="{Binding UploadCommand}" />
            <Button Content="&#xE72B;" ToolTip="Download selected (remote → local)" FontFamily="{StaticResource Font.Icon}"
                    Width="34" Height="34" Margin="0,4" Command="{Binding DownloadCommand}" />
        </StackPanel>

        <!-- Remote pane -->
        <DockPanel Grid.Column="2" Margin="4">
            <Grid DockPanel.Dock="Top">
                <TextBlock Text="{Binding Remote.Kind, StringFormat='Remote ({0})'}" FontWeight="Bold"
                           Margin="2,0,0,4" Foreground="{StaticResource Brush.TextDim}" />
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                <Button Content="&#xE72B; Up" Style="{StaticResource ToolbarButton}" Command="{Binding Remote.UpCommand}" />
                <Button Content="&#xE72C; Refresh" Style="{StaticResource ToolbarButton}" Command="{Binding Remote.RefreshCommand}" />
                <Button Content="&#xE8F4; New folder" Style="{StaticResource ToolbarButton}" Command="{Binding Remote.NewFolderCommand}" />
            </StackPanel>
            <TextBox DockPanel.Dock="Top" Text="{Binding Remote.CurrentPath, Mode=OneWay}" IsReadOnly="True"
                     Background="{StaticResource Brush.Panel}" Foreground="{StaticResource Brush.TextDim}"
                     BorderBrush="{StaticResource Brush.Border}" Padding="4,3" Margin="0,0,0,4" />
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Remote.ErrorText}" Foreground="#E06C75"
                       TextWrapping="Wrap" Margin="2,4,2,0"
                       Visibility="{Binding Remote.ErrorText, Converter={x:Static fb:NullToCollapsedConverter.Instance}}" />
            <DataGrid x:Name="RemoteGrid" ItemsSource="{Binding Remote.Entries}" AutoGenerateColumns="False"
                      Background="Transparent" RowBackground="Transparent" BorderThickness="1"
                      BorderBrush="{StaticResource Brush.Border}" GridLinesVisibility="None"
                      HeadersVisibility="Column" IsReadOnly="True" SelectionMode="Extended"
                      Foreground="{StaticResource Brush.Text}" AllowDrop="True"
                      MouseDoubleClick="OnRemoteDoubleClick"
                      PreviewMouseLeftButtonDown="OnGridPreviewLeftDown"
                      PreviewMouseMove="OnGridPreviewMouseMove"
                      DragOver="OnGridDragOver" Drop="OnRemoteDrop">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Name" Width="*" CellTemplate="{StaticResource NameCell}" SortMemberPath="Name" />
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="90" />
                    <DataGridTextColumn Header="Modified" Binding="{Binding ModifiedText}" Width="130" />
                    <DataGridTextColumn Header="Perms" Binding="{Binding Permissions}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>
        </DockPanel>
    </Grid>
</UserControl>
