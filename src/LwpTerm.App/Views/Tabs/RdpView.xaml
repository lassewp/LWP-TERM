<UserControl x:Class="LwpTerm.App.Views.Tabs.RdpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:tabsvm="clr-namespace:LwpTerm.App.ViewModels.Tabs"
             xmlns:tabs="clr-namespace:LwpTerm.App.Views.Tabs"
             xmlns:panelsvm="clr-namespace:LwpTerm.App.ViewModels.Panels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance tabsvm:RdpTabViewModel}"
             Background="#101010">
    <Grid>
        <!-- Collapse the RDP HWND host while disconnected so the WPF overlay
             below is not hidden by WinForms airspace. -->
        <ContentPresenter x:Name="Slot"
                          Visibility="{Binding IsDisconnected, Converter={x:Static panelsvm:InverseBoolToVisibilityConverter.Instance}}" />

        <TextBlock Text="{Binding StatusText}" Foreground="#C0C0C0"
                   HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding State}" Value="Connecting">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <tabs:SessionDisconnectedOverlay>
            <tabs:SessionDisconnectedOverlay.ExtraContent>
                <Button Content="Open in mstsc.exe instead" Padding="10,4"
                        Command="{Binding OpenInMstscCommand}" />
            </tabs:SessionDisconnectedOverlay.ExtraContent>
        </tabs:SessionDisconnectedOverlay>
    </Grid>
</UserControl>
