<UserControl x:Class="LwpTerm.App.Views.Panels.TransfersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:panelsvm="clr-namespace:LwpTerm.App.ViewModels.Panels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance panelsvm:TransfersViewModel}"
             Background="{StaticResource Brush.BgAlt}"
             TextElement.Foreground="{StaticResource Brush.Text}">

    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4">
            <Button Content="Clear finished" Style="{StaticResource ToolbarButton}" Command="{Binding ClearFinishedCommand}" />
        </StackPanel>

        <Grid>
            <DataGrid ItemsSource="{Binding Items}" AutoGenerateColumns="False"
                      Background="Transparent" BorderThickness="0" GridLinesVisibility="None"
                      HeadersVisibility="Column" IsReadOnly="True" RowBackground="Transparent"
                      Foreground="{StaticResource Brush.Text}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="" Binding="{Binding Detail}" Width="2*" />
                    <DataGridTemplateColumn Header="Progress" Width="160">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ProgressBar Minimum="0" Maximum="100" Height="12"
                                             Value="{Binding ProgressPercent, Mode=OneWay}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeText}" Width="150" />
                    <DataGridTextColumn Header="Speed" Binding="{Binding SpeedText}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="90" />
                    <DataGridTemplateColumn Width="70">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Cancel" Padding="6,1" Command="{Binding CancelCommand}"
                                        Visibility="{Binding IsFinished, Converter={x:Static panelsvm:InverseBoolToVisibilityConverter.Instance}}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="No transfers yet. Drag files between the panes in an SFTP/FTP tab."
                       Foreground="{StaticResource Brush.TextDim}"
                       HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>
    </DockPanel>
</UserControl>
