<UserControl x:Class="LwpTerm.App.Views.Panels.SessionTreeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:LwpTerm.App.ViewModels"
             mc:Ignorable="d"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{d:DesignInstance vm:SessionTreeViewModel}"
             Background="{StaticResource Brush.BgAlt}"
             TextElement.Foreground="{StaticResource Brush.Text}">

    <UserControl.Resources>
        <vm:BoolToCollapsedConverter x:Key="BoolToCollapsed" />
    </UserControl.Resources>

    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="6">
            <TextBox x:Name="FilterBox"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Background="{StaticResource Brush.Panel}"
                     Foreground="{StaticResource Brush.Text}"
                     BorderBrush="{StaticResource Brush.Border}"
                     Padding="4,3" />
            <TextBlock Text="Filter sessions…" Margin="6,0,0,0"
                       Foreground="{StaticResource Brush.TextDim}"
                       IsHitTestVisible="False" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilterText}" Value="">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Grid>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="6">
            <Button Content="＋ Session" Style="{StaticResource ToolbarButton}" Command="{Binding AddSessionCommand}" />
            <Button Content="＋ Folder" Style="{StaticResource ToolbarButton}" Command="{Binding AddFolderCommand}" />
        </StackPanel>

        <TreeView x:Name="Tree"
                  ItemsSource="{Binding Roots}"
                  Background="Transparent"
                  BorderThickness="0"
                  Foreground="{StaticResource Brush.Text}"
                  AllowDrop="True"
                  MouseDoubleClick="OnTreeDoubleClick"
                  PreviewMouseLeftButtonDown="OnTreePreviewMouseLeftButtonDown"
                  PreviewMouseMove="OnTreePreviewMouseMove"
                  Drop="OnTreeDrop"
                  DragOver="OnTreeDragOver">
            <TreeView.ItemContainerStyle>
                <Style TargetType="TreeViewItem">
                    <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                    <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnItemPreviewRightDown" />
                </Style>
            </TreeView.ItemContainerStyle>
            <TreeView.Resources>
                <HierarchicalDataTemplate DataType="{x:Type vm:SessionNodeViewModel}"
                                          ItemsSource="{Binding Children}">
                    <StackPanel Orientation="Horizontal" Margin="0,2">
                        <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource Font.Icon}"
                                   Margin="0,0,6,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextDim}" />
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Target}" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextDim}" FontSize="11"
                                   Visibility="{Binding IsFolder, Converter={StaticResource BoolToCollapsed}}" />
                    </StackPanel>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
            <TreeView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Connect"
                              Command="{Binding PlacementTarget.DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Open SFTP"
                              Command="{Binding PlacementTarget.DataContext.OpenSftpCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="New Session…"
                              Command="{Binding PlacementTarget.DataContext.AddSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="New Folder…"
                              Command="{Binding PlacementTarget.DataContext.AddFolderCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Edit…"
                              Command="{Binding PlacementTarget.DataContext.EditCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <MenuItem Header="Duplicate"
                              Command="{Binding PlacementTarget.DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    <Separator />
                    <MenuItem Header="Delete"
                              Command="{Binding PlacementTarget.DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                </ContextMenu>
            </TreeView.ContextMenu>
        </TreeView>
    </DockPanel>
</UserControl>
