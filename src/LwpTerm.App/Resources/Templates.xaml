<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:LwpTerm.App.ViewModels"
                    xmlns:panelsvm="clr-namespace:LwpTerm.App.ViewModels.Panels"
                    xmlns:tabsvm="clr-namespace:LwpTerm.App.ViewModels.Tabs"
                    xmlns:panels="clr-namespace:LwpTerm.App.Views.Panels"
                    xmlns:tabs="clr-namespace:LwpTerm.App.Views.Tabs">

    <DataTemplate DataType="{x:Type vm:SessionTreeViewModel}">
        <panels:SessionTreeView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type panelsvm:TransfersViewModel}">
        <panels:TransfersView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type panelsvm:LogViewModel}">
        <panels:LogView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tabsvm:PlaceholderTabViewModel}">
        <tabs:PlaceholderTabView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tabsvm:TerminalTabViewModel}">
        <tabs:TerminalView />
    </DataTemplate>

    <DataTemplate DataType="{x:Type tabsvm:FileBrowserTabViewModel}">
        <tabs:FileBrowserView />
    </DataTemplate>

</ResourceDictionary>
